{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": { "type": "minecraft:model", "model": "farmersdelight:item/cabbage_leaf" }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_false": { "type": "minecraft:model", "model": "farmersdelight:item/cabbage_leaf" },
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:use_duration",
        "remaining": true,
        "scale": 0.048,
        "entries": [
          { "model": { "type": "minecraft:model", "model": "eatinganimation:cabbage_leaf_eating_2" }, "threshold": 0.15 },
          { "model": { "type": "minecraft:model", "model": "eatinganimation:cabbage_leaf_eating_1" }, "threshold": 0.25 },
          { "model": { "type": "minecraft:model", "model": "eatinganimation:cabbage_leaf_eating_0" }, "threshold": 0.45 },
          { "model": { "type": "minecraft:model", "model": "farmersdelight:item/cabbage_leaf" }, "threshold": 1.0 }
        ],
        "fallback": { "type": "minecraft:model", "model": "eatinganimation:cabbage_leaf_eating_2" }
      }
    }
  }
}
