{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": { "type": "minecraft:model", "model": "farmersdelight:item/pie_crust" }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_false": { "type": "minecraft:model", "model": "farmersdelight:item/pie_crust" },
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:use_duration",
        "remaining": true,
        "scale": 0.048,
        "entries": [
          { "model": { "type": "minecraft:model", "model": "eatinganimation:pie_crust_eating_2" }, "threshold": 0.35 },
          { "model": { "type": "minecraft:model", "model": "eatinganimation:pie_crust_eating_1" }, "threshold": 0.42 },
          { "model": { "type": "minecraft:model", "model": "eatinganimation:pie_crust_eating_0" }, "threshold": 0.65 },
          { "model": { "type": "minecraft:model", "model": "farmersdelight:item/pie_crust" }, "threshold": 1.0 }
        ],
        "fallback": { "type": "minecraft:model", "model": "eatinganimation:pie_crust_eating_2" }
      }
    }
  }
}
