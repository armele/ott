{
    "multipart": [
        { "when": {"facing": "north"}, "apply": {"model": "ott:block/stone_bricks/stone_bricks_faucet"} },
        { "when": {"facing": "east"},  "apply": {"model": "ott:block/stone_bricks/stone_bricks_faucet", "y": 90} },
        { "when": {"facing": "south"}, "apply": {"model": "ott:block/stone_bricks/stone_bricks_faucet", "y": 180} },
        { "when": {"facing": "west"},  "apply": {"model": "ott:block/stone_bricks/stone_bricks_faucet", "y": 270} },
        { "when": {"facing": "north", "activated": "true"}, "apply": {"model": "ott:block/water/water_trickle_north_faucet"} },
        { "when": {"facing": "east",  "activated": "true"}, "apply": {"model": "ott:block/water/water_trickle_north_faucet", "y": 90} },
        { "when": {"facing": "south", "activated": "true"}, "apply": {"model": "ott:block/water/water_trickle_north_faucet", "y": 180} },
        { "when": {"facing": "west",  "activated": "true"}, "apply": {"model": "ott:block/water/water_trickle_north_faucet", "y": 270} },
        { "when": {"facing": "north", "activated": "true"}, "apply": {"model": "ott:block/water/water_trickle_north_tail"} },
        { "when": {"facing": "east",  "activated": "true"}, "apply": {"model": "ott:block/water/water_trickle_north_tail", "y": 90} },
        { "when": {"facing": "south", "activated": "true"}, "apply": {"model": "ott:block/water/water_trickle_north_tail", "y": 180} },
        { "when": {"facing": "west",  "activated": "true"}, "apply": {"model": "ott:block/water/water_trickle_north_tail", "y": 270} },
        { "when": {"facing": "north", "activated": "true"}, "apply": {"model": "ott:block/water/water_trickle_north_head"} },
        { "when": {"facing": "east",  "activated": "true"}, "apply": {"model": "ott:block/water/water_trickle_north_head", "y": 90} },
        { "when": {"facing": "south", "activated": "true"}, "apply": {"model": "ott:block/water/water_trickle_north_head", "y": 180} },
        { "when": {"facing": "west",  "activated": "true"}, "apply": {"model": "ott:block/water/water_trickle_north_head", "y": 270} }
